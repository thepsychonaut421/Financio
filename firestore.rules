
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Allow users to read, update, and delete their own processed_invoices
    // And allow them to create new ones, validating the content.
    match /processed_invoices/{docId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.filename is string
        && request.resource.data.status in ['OK','WARN','ERROR','DUPLICATE']
        && request.resource.data.erpMode is bool
        && request.resource.data.payload is map
        && request.resource.data.createdAt == request.time;
    }
  }
}
